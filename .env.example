# Copy to .env.local for development. Never commit real values.
# See README.md "Environment" for what each variable does.

# SITE_URL=https://www.calixeden.com
# NOINDEX=true

# Development: enquiries are logged (without personal data), not delivered.
MAIL_TRANSPORT=log

# Production delivery (required on the live site)
# MAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# ENQUIRY_TO=
# ENQUIRY_FROM=
# FORM_SECRET=

# Admin panel (docs/admin-panel-runbook.md §4). In production these live in
# /etc/calix/calix.env (mode 640), loaded by PM2 with --env-file, never in the repository.
# Absolute, persistent, mode 700, owned by the service user:
# SETTINGS_DIR=/var/lib/calix/settings
# openssl rand -hex 32
# SESSION_SECRET=
# openssl rand -base64 32 (back it up separately: backups can't be restored without it)
# SETTINGS_ENCRYPTION_KEY=
# Only while rotating the key (runbook §4): the old key, read-only, until `admin-user rekey` has run.
# SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# Behind the Nginx snippet in deploy/nginx/ (it overwrites this header).
# TRUSTED_PROXY_HEADER=x-real-ip

# Telegram stays off unless this is true. Set it only after the privacy notice names
# Telegram as a recipient and the runbook §8 checks are done.
# TELEGRAM_DELIVERY_ALLOWED=true

# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# SHOW_CONTENT_PLACEHOLDERS=true
# Review previews only: include the olive story in a production build.
# Requires NOINDEX=true, otherwise the build stops. Set to false to hide it in `next dev`.
# STORY_PREVIEW=true
