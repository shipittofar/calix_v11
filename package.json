{
  "name": "calix-web",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.18"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:preview": "STORY_PREVIEW=true NOINDEX=true next build",
    "start": "next start",
    "start:preview": "STORY_PREVIEW=true NOINDEX=true next start",
    "admin:user": "node --import ./scripts/register-ts.mjs scripts/admin-user.mts",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:story": "node scripts/check-story.mjs config && node scripts/check-story.mjs sources",
    "test": "node --import ./scripts/register-ts.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "next build && node --import ./scripts/register-ts.mjs --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:prodlike": "node --import ./scripts/register-ts.mjs --test --test-concurrency=1 \"tests/prodlike/**/*.test.ts\"",
    "validate": "npm run lint && npm run typecheck && npm test && npm run check:story",
    "verify:builds": "npm run build && node scripts/check-story.mjs output .next public && npm run build:preview && node scripts/check-story.mjs output .next-preview preview"
  },
  "dependencies": {
    "gsap": "3.12.5",
    "next": "16.4.1",
    "nodemailer": "10.1.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "20.19.43",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "playwright": "1.56.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
